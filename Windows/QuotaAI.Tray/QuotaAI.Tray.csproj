<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuotaAI</AssemblyName>
    <ApplicationIcon>QuotaAI.ico</ApplicationIcon>
    <!-- 0.0.0 marks a development build (self-update disabled). Release builds pass -p:Version=<tag version>. -->
    <Version>0.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="QuotaAI.ico" LogicalName="QuotaAI.ico" />
    <EmbeddedResource Include="../../Sources/QuotaAI/Resources/ProviderIcons/chatgpt.icns" LogicalName="codex.icns" />
    <EmbeddedResource Include="../../Sources/QuotaAI/Resources/ProviderIcons/antigravity.icns" LogicalName="antigravity.icns" />
    <EmbeddedResource Include="../../Sources/QuotaAI/Resources/ProviderIcons/claude.png" LogicalName="claude.png" />
    <EmbeddedResource Include="../../Sources/QuotaAI/Resources/ProviderIcons/cursor.png" LogicalName="cursor.png" />
    <ProjectReference Include="../QuotaAI.Core/QuotaAI.Core.csproj" />
  </ItemGroup>
</Project>
